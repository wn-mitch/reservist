        "delivery_witness": "scenario.staff.opening_delivery"
      },
      "item": {
        "item_id": "evidence.international.saudi_output_stages",
        "proposition": "Saudi Arabia announced a 9.5 mb/d third-quarter ceiling; that is intent, not output. Installed capacity is about 10.5 mb/d, liftings are seen only through lagged tanker estimates, and U.S. deliveries and access are observed separately.",
        "source": "staff.us.federal_reserve.international",
        "reference_period": "1979-07/1979-08",
        "observed_value": {
          "announcement": "9.5 mb/d ceiling effective 1979-07-01",
          "capacity": "about 10.5 mb/d installed sustainable capacity (GAO, January 1978)",
          "production": "weekly liftings estimated from tanker and terminal reports, about two weeks late",
          "delivery": "U.S. import receipts reported monthly",
          "access": "no U.S. restriction on Saudi crude in force"
        },
        "uncertainty": [
          {
            "kind": "measurement",
            "description": "Tanker-based liftings estimates lag and are revised."
          },
          {
            "kind": "strategic",
            "description": "Saudi officials may state output above or below actual liftings."
          }
        ]
      }
    }
