    "task_id": "task.international.saudi_liftings_follow_up",
    "title": "International Finance liftings assessment",
    "question_template": "Estimate how much of the announced Saudi production increase is actually lifting and reaching the United States.",
    "subject_refs": [
      "system.sa.petroleum.policy",
      "system.sa.petroleum.operations",
      "market.global.crude"
    ],
    "assigned_unit_id": "staff.us.federal_reserve.international",
    "decision_deadline": "1979-08-14T09:30:00-04:00",
    "access_requirements": [
      "profile.chair_scoped",
      "scope.staff.international.confidential"
    ],
    "normal": {
      "expected_completion": "1979-08-09T16:00:00-04:00",
      "capacity_units": 1
    },
    "accelerated": {
      "expected_completion": "1979-08-08T12:00:00-04:00",
      "capacity_units": 2
    },
    "missed_completion": "1979-08-14T12:00:00-04:00",
    "displaced_deliverable_id": "deliverable.international.weekly_oil_note",
    "displaced_revised_due_time": "1979-08-15T12:00:00-04:00",
    "required_unit_evidence_id": "evidence.international.saudi_output_stages",
    "completion_event_id": "scheduled.staff.international.saudi_liftings_follow_up",
    "routing": {
      "request_id": "request.saudi_liftings",
      "planning_unit_id": "staff.us.federal_reserve.international",
      "requested_scope": "scope.staff.international.confidential",
      "conflict_requesting_unit_id": "staff.us.federal_reserve.monetary_affairs"
    },
    "wording": {
      "unit_label": "International Finance",
      "displacement_tradeoff": "delays the weekly oil note past the Committee meeting",
      "capacity_tradeoff": "uses International Finance's remaining uncommitted capacity"
    },
    "assessment": {
      "record_id": "assessment.international.saudi_liftings_follow_up",
      "conclusion_distribution": [
        {
          "proposition": "oil_supply_relief",
          "estimate": 0.35,
          "lower": 0.2,
          "upper": 0.55,
          "confidence": 0.6,
          "summary": "Most of the announced Saudi increase is plausibly lifting, but spot prices and import costs reflect earlier shortfalls and will ease slowly.",
          "uncertainty_kind": "measurement"
        }
      ],
      "assumptions": [
        "Tanker reports cover most Ras Tanura and Ju'aymah loadings.",
        "The third-quarter ceiling holds through September."
      ],
      "unavailable_or_stale_inputs": [
        {
          "kind": "measurement",
          "description": "Liftings estimates lag about two weeks and are revised.",
          "evidence_refs": [
            "evidence.international.saudi_output_stages"
          ]
        },
        {
          "kind": "strategic",
          "description": "Official statements may overstate or understate liftings.",
          "evidence_refs": [
            "evidence.international.saudi_output_stages"
          ]
        },
        {
          "kind": "institutional",
          "description": "U.S. import receipts for August are not yet reported.",
          "evidence_refs": []
        }
      ],
      "package_alternative_assessments": {
        "ALT_A_EASE": "Easing now bets on an oil relief the liftings evidence does not yet show.",
        "ALT_B_HOLD": "Holding leaves the oil-driven price surge to run through wages.",
        "FIRM_BAND": "A modest firming leans against the second-round effects of higher import costs.",
        "ALT_C_FIRM": "A larger firming leans harder against second-round effects at more output risk.",
        "RESERVES_PATH": "A reserves path controls money growth regardless of the oil reading."
      },
      "dissent": [
        {
          "dissenting_unit_id": "staff.us.federal_reserve.monetary_affairs",
          "basis": "Monetary Policy weighs money growth above the oil reading and does not infer that supply relief changes the policy choice."
        }
      ],
      "confidence": 0.6,
      "expected_next_information": "Late-August tanker estimates and July U.S. import receipts."
    }
  }
