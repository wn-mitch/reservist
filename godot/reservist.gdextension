[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]
macos.debug = "res://../target/debug/libreservist_godot.dylib"
macos.release = "res://../target/release/libreservist_godot.dylib"
linux.debug.x86_64 = "res://../target/debug/libreservist_godot.so"
linux.release.x86_64 = "res://../target/release/libreservist_godot.so"
linux.debug.arm64 = "res://../target/debug/libreservist_godot.so"
linux.release.arm64 = "res://../target/release/libreservist_godot.so"
windows.debug.x86_64 = "res://../target/debug/reservist_godot.dll"
windows.release.x86_64 = "res://../target/release/reservist_godot.dll"
